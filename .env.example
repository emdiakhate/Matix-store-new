# ============================================================================
# MATIX B2B Marketplace - Variables d'environnement
# ============================================================================
# Copiez ce fichier vers .env.local et remplissez les valeurs

# ============================================================================
# SUPABASE
# ============================================================================
# URL du projet Supabase (trouvable dans Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé publique (anon key) - pour le client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role - pour le serveur (NE PAS exposer côté client!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================================
# BICTORYS (Paiements)
# ============================================================================
# Mode test (true) ou production (false)
NEXT_PUBLIC_BICTORYS_TEST_MODE=true

# URL de l'API Bictorys
NEXT_PUBLIC_BICTORYS_API_URL=https://api.bictorys.com

# Clé API Bictorys (trouvable dans le dashboard Bictorys)
BICTORYS_API_KEY=your_bictorys_api_key

# URL de callback pour les webhooks Bictorys
BICTORYS_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# APPLICATION
# ============================================================================
# URL de base de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environnement (development, staging, production)
NEXT_PUBLIC_ENV=development

# ============================================================================
# OPTIONNEL - Services externes
# ============================================================================
# Google Maps API (pour la géolocalisation)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry DSN (pour le monitoring d'erreurs)
# SENTRY_DSN=

# Analytics
# NEXT_PUBLIC_GA_TRACKING_ID=
