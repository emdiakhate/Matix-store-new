sm text-gray-500\">{currentUser.email}</p>\n                <p className=\"text-xs text-purple-600 capitalize\">Client</p>\n              </div>\n\n              {/* Menu Navigation */}\n              <nav className=\"space-y-1\">\n                {menuItems.map((item) => (\n                  <Link\n                    key={item.id}\n                    href={item.id === 'dashboard' ? '/dashboard/client' : `/dashboard/client/${item.id}`}\n                    className={`w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left transition-colors ${\n                      activePage === item.id \n                        ? 'bg-purple-100 text-purple-700 font-medium' \n                        : 'text-gray-600 hover:bg-gray-50 hover:text-purple-600'\n                    }`}\n                  >\n                    {item.icon}\n                    <span className=\"text-sm\">{item.label}</span>\n                  </Link>\n                ))}\n              </nav>\n            </Card>\n          </div>\n\n          {/* Main Content */}\n          <div className=\"lg:col-span-3\">\n            <div className=\"mb-6\">\n              <h1 className=\"text-2xl font-bold text-gray-900\">Mon Espace Client</h1>\n            </div>\n\n            {/* Stats Cards */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8\">\n              {stats.map((stat, index) => (\n                <Card key={index} className=\"p-6\">\n                  <div className=\"flex items-center justify-between\">\n                    <div>\n                      <p className=\"text-sm text-gray-600 mb-1\">{stat.title}</p>\n                      <p className=\"text-2xl font-bold text-gray-900\">{stat.value}</p>\n                    </div>\n                    <div className={`p-3 rounded-full ${stat.bgColor}`}>\n                      <div className={stat.iconColor}>\n                        {stat.icon}\n                      </div>\n                    </div>\n     