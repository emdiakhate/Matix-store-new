-auto px-4 py-4\">\n          <Link href=\"/\">\n            <Button variant=\"ghost\" className=\"mb-4\">\n              <ArrowLeft className=\"h-4 w-4 mr-2\" />\n              Retour à l'accueil\n            </Button>\n          </Link>\n          <nav className=\"text-sm text-gray-600\">\n            <span>Accueil</span> / <span>Volailles</span> / <span className=\"text-green-600\">{product.name}</span>\n          </nav>\n        </div>\n      </div>\n\n      <div className=\"container mx-auto px-4 py-8\">\n        <div className=\"grid lg:grid-cols-2 gap-12\">\n          {/* Images */}\n          <div>\n            <div className=\"mb-4\">\n              <img \n                src={product.images[selectedImage]} \n                alt={product.name}\n                className=\"w-full h-96 object-cover rounded-lg\"\n              />\n            </div>\n            <div className=\"grid grid-cols-4 gap-2\">\n              {product.images.map((image, index) => (\n                <img \n                  key={index}\n                  src={image} \n                  alt={`${product.name} ${index + 1}`}\n                  className={`h-20 object-cover rounded cursor-pointer border-2 ${\n                    selectedImage === index ? 'border-green-600' : 'border-gray-200'\n                  }`}\n                  onClick={() => setSelectedImage(index)}\n                />\n              ))}\n            </div>\n          </div>\n\n          {/* Product Info */}\n          <div>\n            <div className=\"mb-4\">\n              <h1 className=\"text-3xl font-bold text-gray-900 mb-2\">{product.name}</h1>\n              <p className=\"text-gray-600\">Par {product.producer} • {product.location}</p>\n            </div>\n\n            <div className=\"flex items-center gap-4 mb-6\">\n              <div className=\"flex items-center gap-1\">\n                {[...Array(5)].map((_, i) => (\n                  <Star key={i} className={`h-5 w-5 ${i < Math.floor(product.rating)