)}\n              </nav>\n            </Card>\n          </div>\n\n          {/* Main Content */}\n          <div className=\"lg:col-span-3\">\n            {/* Breadcrumb */}\n            <div className=\"flex items-center gap-2 mb-6\">\n              <Link href=\"/dashboard/products\" className=\"text-gray-600 hover:text-gray-900\">\n                <ArrowLeft className=\"h-4 w-4\" />\n              </Link>\n              <span className=\"text-gray-400\">/</span>\n              <Link href=\"/dashboard/products\" className=\"text-gray-600 hover:text-gray-900\">\n                Mes Produits\n              </Link>\n              <span className=\"text-gray-400\">/</span>\n              <span className=\"text-gray-900 font-medium\">{product.name}</span>\n            </div>\n\n            {/* Product Details */}\n            <Card className=\"p-6 mb-6\">\n              <div className=\"grid md:grid-cols-2 gap-6\">\n                <div>\n                  <img \n                    src={product.image} \n                    alt={product.name}\n                    className=\"w-full h-64 object-cover rounded-lg\"\n                  />\n                </div>\n                <div>\n                  <h1 className=\"text-2xl font-bold text-gray-900 mb-2\">{product.name}</h1>\n                  <p className=\"text-gray-600 mb-4\">{product.description}</p>\n                  \n                  <div className=\"space-y-3 mb-6\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-medium text-gray-700\">Catégorie:</span>\n                      <span className=\"text-gray-600\">{product.category}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-medium text-gray-700\">Prix:</span>\n                      <span className=\"text-green-600 font-bold\">{product.price} FCFA</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-medium text-gray-700\">Stock:</span>\n                      <span className=\"text-gray-600\">{product.stock} unités</span>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-medium text-gray-700\">Statut:</span>\n                      {getStatusBadge(product.status)}\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-medium text-gray-700\">Rating:</span>\n                      <StarRating rating={product.rating} size=\"md\" showNumber={true} />\n                      <span className=\"text-sm text-gray-500\">({product.reviewCount} avis)</span>\n                    </div>\n                  </div>\n\n                  <div className=\"flex gap-3\">\n                    <Button className=\"bg-green-600 hover:bg-green-700 text-white\">\n                      <Edit className=\"h-4 w-4 mr-2\" />\n                      Modifier\n                    </Button>\n                    <Button variant=\"outline\">\n                      <Copy className=\"h-4 w-4 mr-2\" />\n                      Dupliquer\n                    </Button>\n                  </div>\n                </div>\n              </div>\n            </Card>\n\n            {/* Reviews Section */}\n            <div className=\"grid lg:grid-cols-3 gap-6\">\n              {/* Review Stats */}\n              <div className=\"lg:col-span-1\">\n                {reviewStats && <ReviewStats stats={reviewStats} />}\n              </div>\n\n              {/* Reviews List */}\n              <div className=\"lg:col-span-2\">\n                <Card className=\"p-6\">\n                  <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">Avis Clients</h3>\n                  \n                  {currentReviews.length > 0 ? (\n                    <div className=\"space-y-4\">\n                      {currentReviews.map((review) => (\n                        <ReviewCard key={review.id} review={review} />\n                      ))}\n                      \n                      {/* Pagination */}\n                      {totalPages > 1 && (\n                        <div className=\"flex items-center justify-between mt-6 pt-4 border-t\">\n                          <div className=\"text-sm text-gray-600\">\n                            Affichage de {startIndex + 1} à {Math.min(endIndex, reviews.length)} sur {reviews.length} avis\n                          </div>\n                          <div className=\"flex items-center gap-2\">\n                            <Button\n                              variant=\"outline\"\n                              size=\"sm\"\n                              onClick={() => setCurrentPage(prev => Math.max(prev - 1, 1))}\n                              disabled={currentPage === 1}\n                            >\n                              <ChevronLeft className=\"h-4 w-4\" />\n                            </Button>\n                            <span className=\"text-sm text-gray-600\">\n                              Page {currentPage} sur {totalPages}\n                            </span>\n                            <Button\n                              variant=\"outline\"\n                              size=\"sm\"\n                              onClick={() => setCurrentPage(prev => Math.min(prev + 1, totalPages))}\n                              disabled={currentPage === totalPages}\n                            >\n                              <ChevronRight className=\"h-4 w-4\" />\n                            </Button>\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  ) : (\n                    <div className=\"text-center py-8\">\n                      <Star className=\"h-12 w-12 text-gray-400 mx-auto mb-4\" />\n                      <h4 className=\"text-lg font-medium text-gray-900 mb-2\">Aucun avis pour le moment</h4>\n                      <p className=\"text-gray-600\">Ce produit n'a pas encore reçu d'avis de la part des distributeurs.</p>\n                    </div>\n                  )}\n                </Card>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/malick/Documents/GitHub/Matix-store-new/app/dashboard/products/add/page.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":61,"column":59,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1972,2019],"text":"Nous sommes disponibles 24h/7j, Besoin d&apos;aide ?"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1972,2019],"text":"Nous sommes disponibles 24h/7j, Besoin d&lsquo;aide ?"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1972,2019],"text":"Nous sommes disponibles 24h/7j, Besoin d&#39;aide ?"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1972,2019],"text":"Nous sommes disponibles 24h/7j, Besoin d&rsquo;aide ?"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":117,"column":19,"nodeType":"JSXOpeningElement","endLine":121,"endColumn":21},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apo