ethod] = useState('ups');\n  const [paymentMethod, setPaymentMethod] = useState('cash');\n  const [couponCode, setCouponCode] = useState('');\n  const [cartItems, setCartItems] = useState([\n    {\n      id: 1,\n      name: \"Poulet Fermier Race Locale\",\n      price: 25000,\n      quantity: 1,\n      image: \"https://images.pexels.com/photos/1556909/pexels-photo-1556909.jpeg?auto=compress&cs=tinysrgb&w=120\"\n    },\n    {\n      id: 2,\n      name: \"Poussins Pondeuses ISA\",\n      price: 2500,\n      quantity: 10,\n      image: \"https://images.pexels.com/photos/1267697/pexels-photo-1267697.jpeg?auto=compress&cs=tinysrgb&w=120\"\n    }\n  ]);\n\n  const shippingOptions = [\n    { id: 'ups', name: 'UPS', delivery: 'Livraison Aujourd\\'hui', cost: 2500, icon: '📦' },\n    { id: 'dhl', name: 'DHL', delivery: 'Livraison 2 Jours', cost: 1500, icon: '📦' }\n  ];\n\n  const paymentMethods = [\n    { id: 'cash', name: 'Espèces', icon: '💰', color: '#6B7280' },\n    { id: 'card', name: 'Carte bancaire', icon: '💳', color: '#6B7280' },\n    { id: 'orange', name: 'Orange Money', icon: '📱', color: '#FF6600' },\n    { id: 'wave', name: 'Wave', icon: '📱', color: '#1E40AF' },\n    { id: 'free', name: 'Free Money', icon: '📱', color: '#10B981' }\n  ];\n\n  const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);\n  const shippingCost = shippingOptions.find(option => option.id === shippingMethod)?.cost || 0;\n  const discount = 0;\n  const totalCost = subtotal + shippingCost - discount;\n\n  const updateQuantity = (id: number, newQuantity: number) => {\n    if (newQuantity < 1) return;\n    setCartItems(items =>\n      items.map(item =>\n        item.id === id ? { ...item, quantity: newQuantity } : item\n      )\n    );\n  };\n\n  const removeItem = (id: number) => {\n    setCartItems(items => items.filter(item => item.id !== id));\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gray-50\">\n      {/* Header identique à la page principale */}\n      <div className=\"bg-gray-100 text-gray-700 text-sm py-2\">\n        <div className=\"container mx-auto px-4 flex justify-between items-center\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-gray-600\">📞</span>\n            <span>Nous sommes disponibles 24h/7j, Besoin d'aide ?</span>\n            <span className=\"text-green-600 font-semibold\">+221 77 123 45 67</span>\n          </div>\n          <div className=\"hidden md:flex items-center gap-4 text-sm\">\n            <a href=\"#\" className=\"hover:text-green-600\">À Propos</a>\n            <span className=\"text-gray-400\">|</span>\n            <a href=\"#\" className=\"hover:text-green-600\">Nous Contacter</a>\n            <span className=\"text-gray-400\">|</span>\n            <a href=\"#\" className=\"hover:text-green-600\">Mon Compte</a>\n            <span className=\"text-gray-400\">|</span>\n            <a href=\"#\" className=\"hover:text-green-600 flex items-center gap-1\">\n              🔒 Déconnexion\n            </a>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"bg-green-500 text-white py-4\">\n        <div className=\"container mx-auto px-4\">\n          <div className=\"flex items-center justify-between\">\n            <Link href=\"/\" className=\"flex items-center\">\n              <div className=\"bg-white text-green-500 p-2 rounded-lg mr-3\">\n                <svg className=\"h-6 w-6\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n                  <path d=\"M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z\"/>\n                </svg>\n              </div>\n              <div>\n                <h1 className=\"text-2xl font-bold\">MATIX</h1>\n                <p className=\"text-xs opacity-90\">M A R T</p>\n              </div>\n            </Link>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"bg-white border-b border-gray-200 py-3\">\n        <div className=\"container mx-auto px-4\">\n          <nav className=\"flex items-center space-x-8\">\n            <Link href=\"/\" className=\"text-gray-700 hover:text-green-600 font-medium flex items-center gap-2\">\n              <ArrowLeft className=\"h-4 w-4\" />\n              Retour aux achats\n            </Link>\n          </nav>\n        </div>\n      </div>\n\n      <div className=\"container mx-auto px-4 py-8\">\n        <div className=\"grid lg:grid-cols-5 gap-8\">\n          {/* Colonne Gauche - Formulaire (60%) */}\n          <div className=\"lg:col-span-3\">\n            {/* Toggle Adresse par défaut */}\n            <div className=\"bg-white rounded-lg p-6 mb-6 shadow-sm\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-gray-700 font-medium\">Utiliser l'Adresse de Livraison par Défaut</span>\n                <div className=\"flex items-center\">\n                  <span className=\"mr-2 text-sm text-gray-600\">Oui</span>\n                  <button\n                    onClick={() => setUseDefaultAddress(!useDefaultAddress)}\n                    className={`relative inline-flex h-6 w-11 items-center rounded-full transition-colors ${\n                      useDefaultAddress ? 'bg-green-500' : 'bg-gray-300'\n                    }`}\n                  >\n                    <span\n                      className={`inline-block h-4 w-4 transform rounded-full bg-white transition-transform ${\n                        useDefaultAddress ? 'translate-x-6' : 'translate-x-1'\n                      }`}\n                    />\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            {/* 01. Personal Details */}\n            <div className=\"bg-white rounded-lg p-6 mb-6 shadow-sm\">\n              <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">01. Détails Personnels</h3>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">Prénom</label>\n                  <Input defaultValue=\"Amadou\" className=\"w-full\" />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">Nom</label>\n                  <Input defaultValue=\"Diallo\" className=\"w-full\" />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">Adresse Email</label>\n                  <Input defaultValue=\"amadou@example.com\" className=\"w-full\" />\n                </div>\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">Numéro de Téléphone</label>\n                  <Input defaultValue=\"+221771234567\" className=\"w-full\" />\n                </div>\n              </div>\n            </div>\n\n            {/* 02. Shipping Details */}\n            <div className=\"bg-white rounded-lg p-6 mb-6 shadow-sm\">\n              <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">02. Détails de Livraison</h3>\n              <div className=\"space-y-4\">\n                <div>\n                  <label className=\"block text-sm font-medium text-gray-700 mb-2\">Adresse</label>\n                  <Input defaultValue=\"Marché Colobane, Dakar\" className=\"w-full\" />\n                </div>\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                  <div>\n                    <label className=\"block text-sm font-medium text-gray-700 mb-2\">Ville</label>\n                    <Input defaultValue=\"Dakar\" className=\"w-full\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-sm font-medium text-gray-700 mb-2\">Pays</label>\n                    <Input defaultValue=\"Sénégal\" className=\"w-full\" />\n                  </div>\n                  <div>\n                    <label className=\"block text-sm font-medium text-gray-700 mb-2\">Code Postal</label>\n                    <Input defaultValue=\"10200\" className=\"w-full\" />\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Shipping Cost */}\n            <div className=\"bg-white rounded-lg p-6 mb-6 shadow-sm\">\n              <h4 className=\"font-semibold text-gray-900 mb-4\">Coût de Livraison</h4>\n              <div className=\"space-y-3\">\n                {shippingOptions.map((option) => (\n                  <div key={option.id} className=\"flex items-center p-3 border rounded-lg\">\n                    <input\n                      type=\"radio\"\n                      id={option.id}\n                      name=\"shipping\"\n                      value={option.id}\n                      checked={shippingMethod === option.id}\n                      onChange={(e) => setShippingMethod(e.target.value)}\n                      className=\"mr-3\"\n                    />\n                    <div className=\"flex items-center flex-1\">\n                      <span className=\"text-xl mr-3\">{option.icon}</span>\n                      <div className=\"flex-1\">\n                        <div className=\"font-medium\">{option.name}</div>\n                        <div className=\"text-sm text-gray-600\">{option.delivery}</div>\n                      </div>\n                      <div className=\"font-semibold\">Coût: {option.cost.toLocaleString()} FCFA</div>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* 03. Payment Method */}\n            <div className=\"bg-white rounded-lg p-6 mb-6 shadow-sm\">\n              <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">03. Méthode de Paiement</h3>\n              <div className=\"space-y-3\">\n                {paymentMethods.map((method) => (\n                  <div key={method.id} className=\"flex items-center p-3 border rounded-lg\">\n                    <input\n                      type=\"radio\"\n                      id={method.id}\n                      name=\"payment\"\n                      value={method.id}\n                      checked={paymentMethod === method.id}\n                      onChange={(e) => setPaymentMethod(e.target.value)}\n                      className=\"mr-3\"\n                    />\n                    <div className=\"flex items-center\">\n                      <span className=\"text-xl mr-3\" style={{ color: method.color }}>{method.icon}</span>\n                      <span className=\"font-medium\" style={{ color: method.color }}>{method.name}</span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Boutons Action */}\n            <div className=\"flex gap-4\">\n              <Button variant=\"outline\" className=\"flex-1 border-purple-500 text-purple-500 hover:bg-purple-50\">\n                Continuer les Achats\n              </Button>\n              <Button className=\"flex-1 bg-green-500 hover:bg-green-600 text-white\">\n                Confirmer la Commande →\n              </Button>\n            </div>\n          </div>\n\n          {/* Colonne Droite - Order Summary (40%) */}\n          <div className=\"lg:col-span-2\">\n            <div className=\"bg-white rounded-lg p-6 shadow-sm sticky top-4\">\n              <h3 className=\"text-lg font-semibold text-gray-900 mb-4\">Résumé de Commande</h3>\n              \n              {/* Produits */}\n              <div className=\"space-y-4 mb-6\">\n                {cartItems.map((item) => (\n                  <div key={item.id} className=\"flex items-center gap-3 p-3 bg-gray-50 rounded-lg\">\n                    <img\n                      src={item.image}\n                      alt={item.name}\n                      className=\"w-12 h-12 object-cover rounded-lg\"\n                    />\n                    <div className=\"flex-1 min-w-0\">\n                      <h4 className=\"font-medium text-sm line-clamp-1\">{item.name}</h4>\n                      <p className=\"text-xs text-gray-500\">Prix Unitaire {item.price.toLocaleString()} FCFA</p>\n                      <p className=\"font-bold text-green-600\">{(item.price * item.quantity).toLocaleString()} FCFA</p>\n                    </div>\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => updateQuantity(item.id, item.quantity - 1)}\n                        className=\"p-1 hover:bg-gray-200 rounded\"\n                      >\n                        <Minus className=\"h-3 w-3\" />\n                      </button>\n                      <span className=\"px-2 py-1 bg-white border rounded text-sm min-w-[30px] text-center\">\n                        {item.quantity}\n                      </span>\n                      <button\n                        onClick={() => updateQuantity(item.id, item.quantity + 1)}\n                        className=\"p-1 hover:bg-gray-200 rounded\"\n                      >\n                        <Plus className=\"h-3 w-3\" />\n                      </button>\n                      <button\n                        onClick={() => removeItem(item.id)}\n                        className=\"p-1 text-red-500 hover:text-red-700\"\n                      >\n                        <Trash2 className=\"h-3 w-3\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              {/* Champ Coupon */}\n              <div className=\"mb-6\">\n                <div className=\"flex gap-2\">\n                  <Input\n                    placeholder=\"Code Coupon\"\n                    value={couponCode}\n                    onChange={(e) => setCouponCode(e.target.value)}\n                    className=\"flex-1\"\n                  />\n                  <Button className=\"bg-green-500 hover:bg-green-600 text-white px-6\">\n                    Appliquer\n                  </Button>\n                </div>\n              </div>\n\n              {/* Calculs */}\n              <div className=\"space-y-3 border-t pt-4\">\n                <div className=\"flex justify-between\">\n                  <span>Sous-total</span>\n                  <span className=\"font-semibold\">{subtotal.toLocaleString()} FCFA</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>Coût de Livraison</span>\n                  <span className=\"font-semibold\">{shippingCost.toLocaleString()} FCFA</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>Réduction</span>\n                  <span className=\"font-semibold text-orange-500\">{discount.toLocaleString()} FCFA</span>\n                </div>\n                <div className=\"flex justify-between text-lg font-bold border-t pt-3\">\n                  <span>COÛT TOTAL</span>\n                  <span>{totalCost.toLocaleString()} FCFA</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Section App */}\n        <div className=\"mt-16 bg-gradient-to-r from-green-50 to-blue-50 rounded-2xl p-8\">\n          <div className=\"grid lg:grid-cols-2 gap-8 items-center\">\n            <div className=\"text-center lg:text-left\">\n              <div className=\"text-6xl mb-4\">📱</div>\n              <h3 className=\"text-2xl font-bold text-gray-900 mb-4\">\n                Obtenez Vos Besoins Quotidiens Depuis Notre Boutique Matix\n              </h3>\n              <p className=\"text-gray-600 mb-6\">\n                Il y a de nombreux produits que vous trouverez dans notre boutique. \n                Choisissez votre produit nécessaire quotidien dans notre boutique Matix \n                et obtenez des offres spéciales.\n              </p>\n              <div className=\"flex flex-col sm:flex-row gap-4 justify-center lg:justify-start\">\n                <Button className=\"bg-black hover:bg-gray-800 text-white\">\n                  <img src=\"https://upload.wikimedia.org/wikipedia/commons/7/78/Google_Play_Store_badge_EN.svg\" alt=\"Google Play\" className=\"h-6 mr-2\" />\n                  Google Play\n                </Button>\n                <Button className=\"bg-black hover:bg-gray-800 text-white\">\n                  <img src=\"https://upload.wikimedia.org/wikipedia/commons/3/3c/Download_on_the_App_Store_Badge.svg\" alt=\"App Store\" className=\"h-6 mr-2\" />\n                  App Store\n                </Button>\n              </div>\n            </div>\n            <div className=\"text-center\">\n              <div className=\"text-8xl\">🛒</div>\n            </div>\n          </div>\n        </div>\n\n        {/* Features Bar */}\n        <div className=\"mt-12 grid grid-cols-1 md:grid-cols-4 gap-6 bg-white rounded-lg p-6 shadow-sm\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-green-100 p-2 rounded-full\">\n              <Truck className=\"h-5 w-5 text-green-600\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-sm\">Livraison Gratuite</div>\n              <div className=\"text-xs text-gray-500\">À partir de 50,000 FCFA</div>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-green-100 p-2 rounded-full\">\n              <Phone className=\"h-5 w-5 text-green-600\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-sm\">Support 24/7</div>\n              <div className=\"text-xs text-gray-500\">À tout moment</div>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-green-100 p-2 rounded-full\">\n              <Shield className=\"h-5 w-5 text-green-600\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-sm\">Paiement Sécurisé</div>\n              <div className=\"text-xs text-gray-500\">100% Sécurisé</div>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-green-100 p-2 rounded-full\">\n              <Award className=\"h-5 w-5 text-green-600\" />\n            </div>\n            <div>\n              <div className=\"font-medium text-sm\">Dernières Offres</div>\n              <div className=\"text-xs text-gray-500\">Jusqu'à 25% de réduction</div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/Users/malick/Documents/GitHub/Matix-store-new/app/dashboard-unified/page.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":210,"column":80,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[6468,6482],"text":"Type d&apos;élevage"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[6468,6482],"text":"Type d&lsquo;élevage"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[6468,6482],"text":"Type d&#39;élevage"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[6468,6482],"text":"Type d&rsquo;élevage"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":224,"column":82,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[7091,7110],"text":"Nom de l&apos;entreprise"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[7091,7110],"text":"Nom de l&lsquo;entreprise"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[7091,7110],"text":"Nom de l&#39;entreprise"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[7091,7110],"text":"Nom de l&rsquo;entreprise"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// Page de test pour le nouveau système unifié\n// Démonstration du layout adaptatif\n\n'use client';\n\nimport { useState } from 'react';\nimport AdaptiveLayout from '@/components/layouts/AdaptiveLayout';\nimport { Card } from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Badge } from '@/components/ui/badge';\nimport { useProfile } from '@/lib/hooks/useProfile';\nimport { \n  BarChart3,\n  Package,\n  Users,\n  TrendingUp,\n  MapPin,\n  Star,\n  Bell,\n  FileText,\n  ShoppingCart,\n  Search,\n  Settings,\n  User as UserIcon,\n  Building,\n  Zap\n} from 'lucide-react';\n\nexport default function UnifiedDashboardPage() {\n  const {\n    user,\n    isLoading,\n    error,\n    role,\n    isProducer,\n    isDistributor,\n    roleLabel,\n    roleIcon,\n    roleColor,\n    hasPermission,\n    producerFields,\n    distributorFields,\n    userStats\n  } = useProfile();\n\n  const [activeTab, setActiveTab] = useState('overview');\n\n  // Statistiques adaptatives selon le rôle\n  const getStats = () => {\n    if (isProducer) {\n      return [\n        {\n          title: 'Produits Publiés',\n          value: '45',\n          icon: <Package className=\"h-5 w-5\" />,\n          color: 'text-green-600',\n          bgColor: 'bg-green-50',\n          borderColor: 'border-green-200'\n        },\n        {\n          title: 'Commandes Reçues',\n          value: '23',\n          icon: <ShoppingCart className=\"h-5 w-5\" />,\n          color: 'text-blue-600',\n          bgColor: 'bg-blue-50',\n          borderColor: 'border-blue-200'\n        },\n        {\n          title: 'Revenus du Mois',\n          value: '450,000 FCFA',\n          icon: <TrendingUp className=\"h-5 w-5\" />,\n          color: 'text-purple-600',\n          bgColor: 'bg-purple-50',\n          borderColor: 'border-purple-200'\n        },\n        {\n          title: 'Note Moyenne',\n          value: '4.8',\n          icon: <Star className=\"h-5 w-5\" />,\n          color: 'text-orange-600',\n          bgColor: 'bg-orange-50',\n          borderColor: 'border-orange-200'\n        }\n      ];\n    } else {\n      return [\n        {\n          title: 'Annonces Actives',\n          value: '12',\n          icon: <FileText className=\"h-5 w-5\" />,\n          color: 'text-blue-600',\n          bgColor: 'bg-blue-50',\n          borderColor: 'border-blue-200'\n        },\n        {\n          title: 'Propositions Envoyées',\n          value: '18',\n          icon: <Bell className=\"h-5 w-5\" />,\n          color: 'text-green-600',\n          bgColor: 'bg-green-50',\n          borderColor: 'border-green-200'\n        },\n        {\n          title: 'Budget Disponible',\n          value: '2,500,000 FCFA',\n          icon: <TrendingUp className=\"h-5 w-5\" />,\n          color: 'text-purple-600',\n          bgColor: 'bg-purple-50',\n          borderColor: 'border-purple-200'\n        },\n        {\n          title: 'Partenaires',\n          value: '35',\n          icon: <Users className=\"h-5 w-5\" />,\n          color: 'text-orange-600',\n          bgColor: 'bg-orange-50',\n          borderColor: 'border-orange-200'\n        }\n      ];\n    }\n  };\n\n  const stats = getStats();\n\n  return (\n    <AdaptiveLayout activePage=\"dashboard\">\n      <div className=\"space-y-6\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <h1 className=\"text-3xl font-bold text-gray-900 mb-2\">\n              Dashboard {roleIcon} {roleLabel}\n            </h1>\n            <p className=\"text-gray-600\">\n              Bienvenue sur votre tableau de bord {roleLabel.toLowerCase()}\n            </p>\n          </div>\n          \n          <div className=\"flex items-center gap-2\">\n            <Badge className={`${roleColor === 'green' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}`}>\n              {roleIcon} {roleLabel}\n            </Badge>\n            {user?.is_verified && (\n              <Badge className=\"bg-green-100 text-green-800\">\n                ✓ Vérifié\n              </Badge>\n            )}\n          </div>\n        </div>\n\n        {/* Statistiques */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {stats.map((stat, index) => (\n            <Card key={index} className={`p-6 ${stat.bgColor} ${stat.borderColor} border-2`}>\n              <div className=\"flex items-center justify-between\">\n                <div>\n                  <p className=\"text-sm font-medium text-gray-600 mb-1\">\n                    {stat.title}\n                  </p>\n                  <p className={`text-2xl font-bold ${stat.color}`}>\n                    {stat.value}\n                  </p>\n                </div>\n                <div className={`p-3 rounded-lg ${stat.bgColor}`}>\n                  {stat.icon}\n                </div>\n              </div>\n            </Card>\n          ))}\n        </div>\n\n        {/* Contenu spécifique au rôle */}\n        <div className=\"grid md:grid-cols-2 gap-6\">\n          {/* Informations du profil */}\n          <Card className=\"p-6\">\n            <h3 className=\"text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2\">\n              <UserIcon className=\"h-5 w-5 text-gray-600\" />\n              Informations du Profil\n            </h3>\n            \n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"text-sm font-medium text-gray-500\">Nom complet</label>\n                <p className=\"text-gray-900\">{user?.full_name}</p>\n              </div>\n              \n              <div>\n                <label className=\"text-sm font-medium text-gray-500\">Email</label>\n                <p className=\"text-gray-900\">{user?.email}</p>\n              </div>\n              \n              <div>\n                <label className=\"text-sm font-medium text-gray-500\">Téléphone</label>\n                <p className=\"text-gray-900\">{user?.phone}</p>\n              </div>\n              \n              <div>\n                <label className=\"text-sm font-medium text-gray-500\">Région</label>\n                <p className=\"text-gray-900\">{user?.region}</p>\n              </div>\n              \n              {isProducer && producerFields && (\n                <>\n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">Nom de la ferme</label>\n                    <p className=\"text-gray-900\">{producerFields.farm_name || 'Non défini'}</p>\n                  </div>\n                  \n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">Type d'élevage</label>\n                    <p className=\"text-gray-900\">{producerFields.type_elevage || 'Non défini'}</p>\n                  </div>\n                  \n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">Capacité</label>\n                    <p className=\"text-gray-900\">{producerFields.capacite || 'Non défini'}</p>\n                  </div>\n                </>\n              )}\n              \n              {isDistributor && distributorFields && (\n                <>\n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">Nom de l'entreprise</label>\n                    <p className=\"text-gray-900\">{distributorFields.business_name || 'Non défini'}</p>\n                  </div>\n                  \n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">NINEA</label>\n                    <p className=\"text-gray-900\">{distributorFields.ninea || 'Non défini'}</p>\n                  </div>\n                  \n                  <div>\n                    <label className=\"text-sm font-medium text-gray-500\">Spécialisations</label>\n                    <p className=\"text-gray-900\">\n                      {distributorFields.specializations?.join(', ') || 'Non définies'}\n                    </p>\n                  </div>\n                </>\n              )}\n            </div>\n          </Card>\n\n          {/* Permissions et capacités */}\n          <Card className=\"p-6\">\n            <h3 className=\"text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2\">\n              <Settings className=\"h-5 w-5 text-gray-600\" />\n              Permissions et Capacités\n            </h3>\n            \n            <div className=\"space-y-3\">\n              {isProducer && (\n                <>\n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('manage_products') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Gérer les produits</span>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('verify_location') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Vérifier la localisation</span>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('manage_delivery_settings') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Gérer les paramètres de livraison</span>\n                  </div>\n                </>\n              )}\n              \n              {isDistributor && (\n                <>\n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('search_producers') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Rechercher des producteurs</span>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('create_requests') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Créer des demandes</span>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('send_propositions') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Envoyer des propositions</span>\n                  </div>\n                  \n                  <div className=\"flex items-center gap-2\">\n                    {hasPermission('manage_alerts') ? (\n                      <div className=\"w-2 h-2 bg-green-500 rounded-full\"></div>\n                    ) : (\n                      <div className=\"w-2 h-2 bg-gray-300 rounded-full\"></div>\n                    )}\n                    <span className=\"text-sm\">Gérer les alertes</span>\n                  </div>\n                </>\n              )}\n            </div>\n          </Card>\n        </div>\n\n        {/* Actions rapides */}\n        <Card className=\"p-6\">\n          <h3 className=\"text-lg font-semibold text-gray-900 mb-4 flex items-center gap-2\">\n            <Zap className=\"h-5 w-5 text-gray-600\" />\n            Actions Rapides\n          </h3>\n          \n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n            {isProducer && (\n              <>\n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <Package className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Mes Produits</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <MapPin className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Géolocalisation</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <ShoppingCart className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Commandes</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <BarChart3 className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Statistiques</span>\n                </Button>\n              </>\n            )}\n            \n            {isDistributor && (\n              <>\n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <Search className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Rechercher</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <FileText className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Mes Annonces</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <Bell className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Alertes</span>\n                </Button>\n                \n                <Button className=\"h-20 flex flex-col items-center justify-center gap-2\">\n                  <Users className=\"h-6 w-6\" />\n                  <span className=\"text-sm\">Partenaires</span>\n                </Button>\n              </>\n            )}\n          </div>\n        </Card>\n      </div>\n    </AdaptiveLayout>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/malick/Documents/GitHub/Matix-store-new/app/dashboard/account/page.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":69,"column":59,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","dat