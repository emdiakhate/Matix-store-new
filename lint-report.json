ull\">\n                    <span className=\"text-white text-sm\">W</span>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"text-center\">\n                <p className=\"text-gray-400\">\n                  Appelez-nous: <span className=\"text-matix-yellow font-bold text-xl\">+221771234567</span>\n                </p>\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <img src=\"https://upload.wikimedia.org/wikipedia/commons/0/04/Visa.svg\" alt=\"Visa\" className=\"h-8\" />\n                <img src=\"https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg\" alt=\"Mastercard\" className=\"h-8\" />\n                <div className=\"bg-orange-500 text-white px-2 py-1 rounded text-xs\">Orange Money</div>\n                <div className=\"bg-blue-500 text-white px-2 py-1 rounded text-xs\">Wave</div>\n              </div>\n            </div>\n\n            <div className=\"text-center mt-8 pt-6 border-t border-gray-800\">\n              <p className=\"text-gray-400\">\n                Copyright 2024 © <span className=\"text-matix-yellow\">MatixLover</span>. Tous droits réservés.\n              </p>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/Users/malick/Documents/GitHub/Matix-store-new/app/dashboard/announcements/page.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":259,"column":27,"nodeType":"JSXOpeningElement","endLine":263,"endColumn":29},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line