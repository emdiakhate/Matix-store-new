e=\"bg-white rounded-2xl w-full max-w-4xl h-5/6 flex flex-col shadow-2xl\">\n        {/* Header */}\n        <div className=\"flex justify-between items-center p-6 border-b border-gray-200\">\n          <div>\n            <h2 className=\"text-xl font-bold text-gray-900\">\n              Facture #{achat.numeroFacture || 'N/A'}\n            </h2>\n            <p className=\"text-gray-500\">Commande #{achat.numeroCommande}</p>\n            <div className=\"flex gap-4 mt-2 text-sm text-gray-600\">\n              <span>Producteur: {achat.producteur.nom}</span>\n              <span>Montant: {achat.montantTotal.toLocaleString('fr-FR')} FCFA</span>\n              <span>Date: {achat.dateAchat}</span>\n            </div>\n          </div>\n          \n          <div className=\"flex gap-2\">\n            {/* Bouton télécharger */}\n            <button\n              onClick={handleDownload}\n              className=\"px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 flex items-center gap-2 transition-colors\"\n            >\n              <Download className=\"w-4 h-4\" />\n              Télécharger\n            </button>\n            \n            {/* Bouton fermer */}\n            <button\n              onClick={onClose}\n              className=\"p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Contenu facture */}\n        <div className=\"flex-1 p-6 overflow-auto\">\n          {achat.factureUrl ? (\n            <iframe\n              src={achat.factureUrl}\n              className=\"w-full h-full border border-gray-200 rounded-lg\"\n              title=\"Aperçu facture\"\n            />\n          ) : (\n            <div className=\"flex items-center justify-center h-full\">\n              <div className=\"text-center\">\n                <div className=\"w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4\">\n                  <Download className=\"w-8 h-8 text-gray-400\" />\n                </div>\n                <h3 className=\"text-lg font-medium text-gray-900 mb-2\">\n                  Facture non disponible\n                </h3>\n                <p className=\"text-gray-500\">\n                  La facture pour cette commande n'est pas encore disponible.\n                </p>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/malick/Documents/GitHub/Matix-store-new/components/Footer.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":48,"column":78,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[2900,2913],"text":"Centre d&apos;Aide"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[2900,2913],"text":"Centre d&lsquo;Aide"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[2900,2913],"text":"Centre d&#39;Aide"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[2900,2913],"text":"Centre d&rsquo;Aide"},"desc":"Replace with `&rsquo;`."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":53,"column":111,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[3438,3462],"text":"Conditions d&apos;Utilisation"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[3438,3462],"text":"Conditions d&lsquo;Utilisation"},"desc":"Replace with `&lsquo;`."},{"message